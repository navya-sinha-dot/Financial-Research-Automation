# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=true
DEBUG=true

# SEC + scraping configuration
SEC_USER_AGENT=FinancialResearchAutomation/1.0 contact@example.com
SEC_REQUEST_DELAY=1
SEC_REQUEST_JITTER=0.6
SEC_TIMEOUT=30
SEC_MAX_RETRIES=4
SEC_CACHE_TTL_SECONDS=86400

# Browser automation
SCRAPER_HEADLESS=false
SCRAPER_SLOW_MO=500
SCRAPER_TIMEOUT=30000
SCRAPER_SCREENSHOTS=true
SCRAPER_SAVE_HTML=true
SCRAPER_MAX_RETRIES=3
SCRAPER_MIN_DELAY_MS=250
SCRAPER_MAX_DELAY_MS=900
SCRAPER_BACKFILL_QUARTERS=4

# Database Configuration
DATABASE_URL=sqlite:///./data/fra.db

# Caching
CACHE_TTL_SECONDS=60

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false

# API Configuration
API_BASE_URL=http://localhost:8000
API_HOST=0.0.0.0
API_PORT=8000
# Leave API_KEY empty to disable auth (local/demo). Set it to require
# X-API-Key on mutating endpoints (POST /companies, /ingest, /reports, PATCH).
API_KEY=
RATE_LIMIT_INGEST=10/minute
RATE_LIMIT_REPORTS=15/minute

# Streamlit Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# Storage Paths
DATA_DIR=data
RAW_DIR=data/raw
PROCESSED_DIR=data/processed
CACHE_DIR=data/cache
DEBUG_DIR=data/debug
REPORTS_DIR=data/reports
